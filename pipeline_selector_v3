    print(f"[+] S-au încărcat {len(db_articles)} articole brute din baza de date.")
    
    # CONFIGURARE: Limita absolută mărită la 100 de articole trimise către prima conversație
    selection_input = []
    source_tracker = {}
    
    for a in db_articles:
        src = a["source_name"]
        cap = SOURCE_CAPS.get(src, 10)
        
        if source_tracker.get(src, 0) < cap:
            short_summary = a["summary"][:100] + "..." if a["summary"] else "No summary available"
            selection_input.append({
                "title": a["title"],
                "source": src,
                "summary": short_summary,
                "link": a["link"]
            })
            source_tracker[src] = source_tracker.get(src, 0) + 1
            
        if len(selection_input) >= 100:  # Limita absolută mărită la 100 de intrări
            break

    print(f"[*] S-au filtrat {len(selection_input)} articole echilibrate pe surse pentru a fi trimise modelului.")

    # CONVERSAȚIA 1: Selecția macro realizată direct de Gemma
    print("\n[*] Pornire Conversația 1: Analiză și selecție știri...")
    system_prompt_1 = (
        "You are a Senior Intelligence Director. Analyze the following list of raw daily news articles from Romania. "
        "Select exactly 5 to 7 articles that represent the highest strategic importance: DOMESTIC POLITICS, MACROECONOMY, NATIONAL SECURITY, or SEVERE SYSTEMIC CRISES. "
        "CRITICAL RULES: "
        "1. You MUST completely IGNORE and FILTER OUT any articles about: Reality TV shows, showbiz, weather forecasts, sports, minor accidents, or generic international news that doesn't involve Romania. "
        "2. If there are only a few actual political/strategic articles, just pick those. Do not fill the quota with garbage news. "
        "Output your selection STRICTLY as a JSON array containing objects with keys: 'title', 'link', 'source'."
    )
    user_prompt_1 = f"Identify the top strategic news from this list: {json.dumps(selection_input)}"
    
    raw_json_selection = call_ollama_stream(system_prompt_1, user_prompt_1, format_json=True)
    
    # Parsarea selecției modelului
    selected_list = []
    try:
        json_clean = raw_json_selection
        if "</think>" in json_clean:
            json_clean = json_clean.split("</think>")[-1].strip()
            
        parsed_selection = json.loads(json_clean)
        
        # Logica robustă de detectare a listei în JSON (indiferent de denumirea cheilor)
        if isinstance(parsed_selection, dict):
            selected_list = parsed_selection.get("selected_articles", None)
            if not selected_list:
                # Căutăm dinamic orice cheie care conține o listă în interiorul dicționarului
                for k, v in parsed_selection.items():
                    if isinstance(v, list):
                        selected_list = v
                        break
            if not selected_list:
                selected_list = list(parsed_selection.values())[0]
        elif isinstance(parsed_selection, list):
            selected_list = parsed_selection
            
        if not isinstance(selected_list, list):
            raise ValueError("Parsed selection is not a list")
            
    except Exception as e:
        print(f"[-] Eșec la decodarea JSON-ului generat: {e}")
        print("[*] Se trece la procesarea de siguranță...")
        selected_list = selection_input[:5]

    # Descărcarea textului complet
    print(f"\n[+] S-au selectat {len(selected_list)} articole.")
    
    scraped_data_package = []
    for idx, item in enumerate(selected_list):
        title = item.get("title", "No Title")
        link = item.get("link", "")
        source = item.get("source", item.get("source_name", "Unknown"))
        
        print(f" -> [{idx+1}/{len(selected_list)}] Descărcare text: {title[:50]}... ", end="", flush=True)
        full_text = scrape_full_text(link)
        
        if full_text and len(full_text) > 100:
            print("[SUCCES]")
            scraped_data_package.append({
                "title": title,
                "source": source,
                "full_text": full_text
            })
        else:
            print("[EȘEC]")

    if not scraped_data_package:
        print("[-] Nu s-a putut descărca textul integral. Proces oprit.")
        exit(1)

    # CONVERSAȚIA 2: Generarea Dosarului
    print("\n[*] Pornire Conversația 2: Generare dosar de presă bazat pe textele integrale...")
    
    system_prompt_2 = (
        "You are a Master OSINT Journalist and Analyst. Read the full scraped text of the selected news articles "
        "and generate a comprehensive, highly detailed news summary dossier in Romanian.\n\n"
        "You MUST strictly follow this exact plain-text format for each article, separating them with double newlines:\n\n"
        "ȘTIREA [Number]: [CLEAN TITLE HERE - DO NOT BOLD, DO NOT USE # OR ANY MARKDOWN AT ALL]\n"
        "[Write a comprehensive, deep, and highly informative narrative summary in Romanian. This summary must "
        "preserve the political context, key figures, critical facts, and include direct verbatim Romanian quotes from "
        "the provided text. Keep it strictly professional, objective, and analytical. Write at least 2-3 detailed paragraphs for each story to ensure deep coverage.]\n"
        "(Sursa: [Source Name] - [Current Date, e.g., 10 Iunie 2026])\n\n"
        "CRITICAL FORMAT RULES:\n"
        "1. Do not use any markdown headers (such as #, ##, ###) or bold any words inside the title line or text.\n"
