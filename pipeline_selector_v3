#!/usr/bin/env python3
import sqlite3
import json
import requests
import subprocess
import socket
import time
import platform
import sys
from datetime import datetime
from bs4 import BeautifulSoup

# Configure stdout encoding to prevent UnicodeEncodeError on Windows console
if sys.platform.startswith("win"):
    sys.stdout.reconfigure(encoding='utf-8')

DB_NAME = "political_intel.db"
MODEL_NAME = "gemma-4-e4b"

# CONFIGURARE: Plafonarea surselor mărită pentru o selecție mult mai largă
SOURCE_CAPS = {
    "G4Media": 15,
    "HotNews": 15,
    "Digi24": 15,
    "B1TV": 15,
    "ActiveNews": 12,
    "Agerpres": 12,
    "Mediafax": 12,
    "Antena 3": 8,
    "România TV": 8
}

def is_ollama_running(port=11434):
    """Verifică dacă portul local de Ollama este activ."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        return s.connect_ex(('localhost', port)) == 0

def ensure_ollama_running():
    """Pornește automat serviciul Ollama dacă acesta este închis."""
    if is_ollama_running():
        print("[+] Serverul Ollama este deja activ.")
        return True
        
    print("[*] Serverul Ollama nu rulează. Se încearcă pornirea automată...")
    try:
        if platform.system() == "Windows":
            subprocess.Popen(["ollama", "serve"], shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.Popen(["ollama", "serve"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        
        for i in range(10):
            print(f" -> Se așteaptă inițializarea serverului... ({i+1}/10)")
            time.sleep(2)
            if is_ollama_running():
                print("[+] Serverul Ollama a pornit cu succes!")
                return True
    except Exception as e:
        print(f"[-] Eroare la pornirea automată a Ollama: {e}")
        return False

def get_all_articles_from_today():
    """Extrage articolele de azi, dar le limitează inteligent pentru a nu bloca GPU-ul."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    today_str = datetime.now().strftime('%Y-%m-%d')
    print(f"[*] Interogare DB pentru data de astăzi: {today_str}")
    
    cursor.execute("""
        SELECT id, source_name, title, summary, link, published_date, scraped_at 
        FROM raw_articles 
        WHERE date(scraped_at, 'localtime') = ? OR published_date = ?
        ORDER BY id DESC
        LIMIT 300
    """, (today_str, today_str))
    rows = cursor.fetchall()
    
    if not rows:
        print("[!] Nicio știre găsită în DB pentru data de astăzi.")
        print("[*] Se încarcă ultimele 150 de știri din baza de date pentru testare.")
        cursor.execute("""
            SELECT id, source_name, title, summary, link, published_date, scraped_at 
            FROM raw_articles 
            ORDER BY id DESC 
            LIMIT 150
        """)
        rows = cursor.fetchall()
        
    conn.close()
    
    articles = []
    for row in rows:
        articles.append({
            "id": row[0],
            "source_name": row[1],
            "title": row[2],
            "summary": row[3],
            "link": row[4],
            "published_date": row[5],
            "scraped_at": row[6]
        })
    return articles

def call_ollama_stream(system_prompt, user_prompt, format_json=False):
    """Efectuează apelul API către Ollama cu context mărit și afișează streaming live brut în consolă."""
    url = "http://localhost:11434/api/chat"
    payload = {
        "model": MODEL_NAME,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        "stream": True,
        "options": {
            "temperature": 0.0,
            "top_p": 0.1,
            "num_ctx": 64000  # CONFIGURARE: Context mărit la 64k tokeni pentru ambele conversații
        }
    }
    if format_json:
        payload["format"] = "json"

    print("\n--- INCEPUT GENERARE MODEL ---")
    full_response = ""
    try:
        # Timeout mărit la 300 de secunde pentru a permite CPU offloading în caz de limitare VRAM
        response = requests.post(url, json=payload, stream=True, timeout=300)
        for line in response.iter_lines():
            if line:
                chunk = json.loads(line.decode('utf-8'))
                text = chunk.get("message", {}).get("content", "")
                sys.stdout.write(text)
                sys.stdout.flush()
                full_response += text
    except Exception as e:
        print(f"\n[-] Eroare la comunicarea cu modelul: {e}")
    
    print("\n--- SFARSIT GENERARE MODEL ---\n")
    return full_response

def scrape_full_text(url):
    """Scrape-ează corpul de text din pagina web a știrii."""
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko)"
    }
    try:
        response = requests.get(url, headers=headers, timeout=10)
        if response.status_code != 200:
            return None
        
        soup = BeautifulSoup(response.text, "html.parser")
        paragraphs = soup.find_all("p")
        
        cleaned_paragraphs = []
        for p in paragraphs:
            text = p.get_text().strip()
            if len(text) > 25:
                cleaned_paragraphs.append(text)
                
        return "\n\n".join(cleaned_paragraphs)[:6000]
    except Exception as e:
        print(f"\n[-] Eroare la scanarea URL-ului {url}: {e}")
        return None

if __name__ == "__main__":
    if not ensure_ollama_running():
        exit(1)
        
    db_articles = get_all_articles_from_today()
    if not db_articles:
        print("[-] Nu s-au găsit articole în baza de date. Proces oprit.")
