        "3. Keep Romanian quotes completely verbatim."
    )
    
    user_prompt_2 = f"Generate the structured news summaries for these fully scraped articles:\n\n{json.dumps(scraped_data_package)}"
    
    dossier_output = call_ollama_stream(system_prompt_2, user_prompt_2, format_json=False)
    
    output_file = "dossier_for_agent_1.txt"
    with open(output_file, "w", encoding="utf-8") as f:
        final_text = dossier_output
        if "</think>" in final_text:
            final_text = final_text.split("</think>")[-1].strip()
        f.write(final_text)
        
    print(f"[+] Proces finalizat. Rezultatele au fost salvate în: {output_file}")