# --- UTILS & OLLAMA COMMS ---
def clean_html(raw_html):
    if not raw_html: return ""
    clean_regex = re.compile('<.*?>')
    return " ".join(re.sub(clean_regex, '', raw_html).split())

def extract_json_from_text(text):
    """Extrage JSON dintr-un text care poate conține markdown sau <think> tags."""
    if "</think>" in text:
        text = text.split("</think>")[-1].strip()
    match = re.search(r'```(?:json)?\s*(\{.*\}|\[.*\])\s*```', text, re.DOTALL)
    if match:
        return match.group(1).strip()
    return text.strip()

def is_ollama_running(port=11434):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        return s.connect_ex(('localhost', port)) == 0

def ensure_ollama_running():
    if is_ollama_running(): return True
    print("[*] Se încearcă pornirea automată a serverului Ollama...")
    try:
        cmd = ["ollama", "serve"]
        if platform.system() == "Windows":
            subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(10):
            time.sleep(2)
            if is_ollama_running(): return True
    except Exception as e:
        print(f"[-] Eroare la pornirea automată: {e}")
    return False

def call_ollama(system_prompt, user_prompt, temp=0.0, top_p=0.1, json_schema=None):
    url = "http://localhost:11434/api/chat"
    
    # ATENȚIE: Dacă primești "[EROARE OLLAMA] Out of memory", schimbă num_ctx la 32000 sau 64000.
    payload = {
        "model": MODEL_NAME,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        "stream": True,
        "options": {
            "temperature": temp,
            "top_p": top_p,
            "num_ctx": 128000
        }
    }
    
    if json_schema:
        if isinstance(json_schema, dict):
            payload["format"] = json_schema
        else:
            payload["format"] = "json"

    print("\n--- INCEPUT GENERARE OLLAMA ---")
    full_response = ""
    try:
        response = requests.post(url, json=payload, stream=True, timeout=None)
        for line in response.iter_lines():
            if line:
                chunk = json.loads(line.decode('utf-8'))
                
                # ACUM PRINDEM ERORILE OLLAMA (EX: OUT OF MEMORY PENTRU CONTEXT)
                if "error" in chunk:
                    print(f"\n\n[!!! EROARE OLLAMA CRITICĂ !!!]\nServerul a refuzat cererea: {chunk['error']}")
                    print("Sugestie: Probabil parametrul 'num_ctx: 128000' cere mai mult RAM decât ai disponibil.")
                    sys.stdout.flush()
                    break
                
                text = chunk.get("message", {}).get("content", "")
                sys.stdout.write(text)
                sys.stdout.flush()
                full_response += text
    except Exception as e:
        print(f"\n[-] Eroare de rețea cu Ollama: {e}")
    print("\n--- SFARSIT GENERARE OLLAMA ---\n")
    
    return extract_json_from_text(full_response)

def scrape_full_text(url):
    try:
        response = requests.get(url, headers=HEADERS, timeout=15)
        if response.status_code != 200: return None
        soup = BeautifulSoup(response.text, "html.parser")
        paragraphs = soup.find_all("p")
        cleaned_paragraphs = [p.get_text().strip() for p in paragraphs if len(p.get_text().strip()) > 25]
        return "\n\n".join(cleaned_paragraphs)[:6000]
    except Exception:
        return None

def get_historical_context(actor):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("""
        SELECT extracted_at, verbatim_evidence 
        FROM extracted_events 
        WHERE actor LIKE ? 
        AND date(extracted_at) < date('now', 'localtime') 
        ORDER BY extracted_at DESC LIMIT 5
    """, (f"%{actor}%",))
    rows = cursor.fetchall()
    conn.close()
    return [{"date": row[0], "past_statement": row[1]} for row in rows]

# ==========================================
# ETAPA 1: Preluare articole brute din RSS
# ==========================================
def run_rss_ingestion():
    print("\n[+] ETAPA 1: Extragere RSS...")
    conn = sqlite3.connect(DB_NAME)
    new_count = 0
    try:
        cursor = conn.cursor()
        for source, url in RSS_FEEDS.items():
            try:
                response = requests.get(url, headers=HEADERS, timeout=15)
                if response.status_code != 200: 
                    # Acum printăm dacă Agerpres (sau altul) pică
                    print(f" -> {source}: EROARE (Status HTTP {response.status_code})")
                    continue
                
                feed = feedparser.parse(response.content)
                for entry in feed.entries:
                    link = entry.get("link", "").strip()
                    if not link: continue
                    
                    cursor.execute("SELECT 1 FROM raw_articles WHERE link = ?", (link,))
                    if cursor.fetchone() is not None: continue
                    
                    title = entry.get("title", "No Title").strip()
                    summary = clean_html(entry.get("summary", entry.get("description", "")))
                    published = datetime.now().strftime("%Y-%m-%d")
                    
                    published_parsed = entry.get("published_parsed") or entry.get("updated_parsed")
                    if published_parsed:
                        published = time.strftime("%Y-%m-%d", published_parsed)

                    cursor.execute("""
                        INSERT OR IGNORE INTO raw_articles (source_name, title, link, summary, published_date)
                        VALUES (?, ?, ?, ?, ?)
                    """, (source, title, link, summary, published))
                    if cursor.rowcount > 0: new_count += 1
                print(f" -> {source}: Actualizat")
            except requests.exceptions.Timeout:
                print(f" -> {source}: EROARE (Timeout)")
            except Exception as e:
                print(f" -> {source}: EROARE ({e})")
        conn.commit()
    finally:
        conn.close()
    print(f"[*] S-au adăugat {new_count} articole noi azi.")

