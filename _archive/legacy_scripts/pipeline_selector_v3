            "summary": (a[3][:100] + "...") if a[3] else "",
            "link": a[4],
            "is_strategic": is_strat
        })

    selection_input = sorted(selection_input, key=lambda x: x["is_strategic"], reverse=True)
    print(f"[*] {len(selection_input)} articole trimise către analiza de relevanță.")

    system_prompt_1 = (
        "You are a Senior Intelligence Director. Analyze the following list of raw daily news articles from Romania. "
        "Select exactly 10 articles that represent the highest strategic importance: DOMESTIC POLITICS, MACROECONOMY, NATIONAL SECURITY, or SEVERE SYSTEMIC CRISES, AS WELL AS 1 OR 2 BIG NEWS FROM OTHER SUBJECTS THAT ARE OF NATIONAL IMPORTANCE. "
